CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_python3-light=y
CONFIG_PACKAGE_python3-flask=y
CONFIG_PACKAGE_python3-yaml=y
CONFIG_PACKAGE_python3-pyserial=y
CONFIG_PACKAGE_python3-sqlite3=y

CONFIG_PACKAGE_nginx-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y

CONFIG_PACKAGE_pisowifi=y
CONFIG_PACKAGE_piefi-branding=y

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

CONFIG_VERSION_DIST="pieFI OS"
CONFIG_VERSION_NUMBER="1.0.0"
CONFIG_VERSION_CODE="piefi-v1"
