#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    nft -f /etc/nftables.d/pisowifi.nft
    procd_open_instance coin
    procd_set_param command /usr/bin/python3 /opt/pisowifi/coin/daemon.py
    procd_set_param respawn
    procd_close_instance
    procd_open_instance portal
    procd_set_param command /usr/bin/python3 /opt/pisowifi/portal/app.py
    procd_set_param env PYTHONPATH=/opt/pisowifi
    procd_set_param respawn
    procd_close_instance
    procd_open_instance admin
    procd_set_param command /usr/bin/python3 /opt/pisowifi/admin/app.py
    procd_set_param env PYTHONPATH=/opt/pisowifi
    procd_set_param respawn
    procd_close_instance
}
